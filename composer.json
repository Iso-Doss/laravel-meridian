{
    "name": "iso-doss/laravel-meridian",
    "description": "Horizon for Laravel database queues: dashboard, metrics and auto-scaling supervisors, without Redis and without changing your jobs. React or Blade UI, dark mode, English & French, strict CSP ready.",
    "keywords": [
        "laravel",
        "queue",
        "database",
        "horizon",
        "monitoring",
        "scheduler",
        "prometheus",
        "meridian"
    ],
    "homepage": "https://github.com/Iso-Doss/laravel-meridian",
    "license": "MIT",
    "authors": [
        {
            "name": "DOSSOU Israël (Iso-Doss)",
            "email": "dossou.israel48@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/queue": "^12.0||^13.0",
        "inertiajs/inertia-laravel": "^3.0",
        "spatie/laravel-package-tools": "^1.16",
        "symfony/process": "^7.0||^8.0"
    },
    "require-dev": {
        "filament/filament": "^4.0||^5.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "laravel/pulse": "^1.4",
        "laravel/slack-notification-channel": "^3.0",
        "laravel/vonage-notification-channel": "^3.0",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.0.0||^10.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "suggest": {
        "ext-pcntl": "Required to pause / continue / gracefully terminate workers.",
        "ext-posix": "Required to signal worker processes.",
        "filament/filament": "To show Meridian in a Filament panel (MeridianPlugin).",
        "laravel/pulse": "To show Meridian in a Laravel Pulse card.",
        "laravel/slack-notification-channel": "Required to send the alerts to Slack.",
        "laravel/vonage-notification-channel": "Required to send the alerts by SMS."
    },
    "autoload": {
        "psr-4": {
            "IsoDoss\\Meridian\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IsoDoss\\Meridian\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IsoDoss\\Meridian\\MeridianServiceProvider"
            ],
            "aliases": {
                "Meridian": "IsoDoss\\Meridian\\Facades\\Meridian"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
